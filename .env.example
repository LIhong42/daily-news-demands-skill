# ===============================================
# Daily News Skill - 环境变量模板
# 复制为 .env 并填入实际值
# ===============================================

# HTTP 请求配置
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RATE_LIMIT_DELAY=1.0
CONCURRENCY=4

# NewsNow API（默认已可用，无需自建）
# 公开服务：https://newsnow.busiyi.world/api/s
# 调用模板：GET {URL}?id={newsnow_id}&latest
NEWSNOW_BASE_URL=https://newsnow.busiyi.world/api/s

# 兼容别名（原项目 TrendSearch-main 用的变量名）
# 留空时回退到 NEWSNOW_BASE_URL
NEWS_API_URL=

# Tavily 兜底（可选，NewsNow 抓不到时用 Tavily 搜索）
TAVILY_API_KEY=

# 数据保留天数（参考原项目 DataStore.clean_old_data 默认 30 天）
DATA_RETENTION_DAYS=30
